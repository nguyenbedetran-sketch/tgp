# Copy this file to .env (in the project root OR backend/) and fill in real
# values. Never commit the real .env file (see .gitignore).

# --- General ---------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Security ----------------------------------------------------------
# Generate a strong random value for production, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_EXPIRE_MINUTES=480

# --- Database ----------------------------------------------------------
DATABASE_PATH=./database/tgp.db

# --- CORS ----------------------------------------------------------
# Comma-separated list of allowed origins, or * for any (development only)
CORS_ORIGINS=*

# --- Uploads -----------------------------------------------------------
UPLOAD_DIR=./backend/static/uploads
MAX_UPLOAD_SIZE_MB=8

# --- Native / JVM service locations ---------------------------------
CPP_CALCULATOR_BIN=./cpp/tgp_calculator
JAVA_BIN=java
JAVA_REPORT_JAR=./java/target/tgp-report-service.jar

# --- Rate limiting -------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=8

# --- Logging -------------------------------------------------------
LOG_DIR=./logs
LOG_LEVEL=INFO

# --- Seed / bootstrap admin account -------------------------------
# On first boot, a configured admin is created with a PBKDF2 password hash.
# Keep the real password in a private .env only; never commit it.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@trangiaphat.example
ADMIN_BOOTSTRAP_PASSWORD=

# --- Company info (NEVER fabricate - fill with real data before launch) ---
# These are also editable at runtime via the admin dashboard
# (Quan ly thong tin cong ty), which writes to the site_settings table.
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_ADDRESS=
COMPANY_TAX_CODE=

# --- Optional notification hooks (wire up once you have real credentials) ---
# NOTIFY_EMAIL_SMTP_HOST=
# NOTIFY_EMAIL_SMTP_PORT=
# NOTIFY_EMAIL_FROM=
# NOTIFY_ZALO_OA_TOKEN=
